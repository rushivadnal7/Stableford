# Copy to .env.local and fill in. Never commit real values.
# Each variable is validated lazily in src/lib/env.ts, so a missing Stripe key
# does not break a route that only needs Supabase.

# --- App ---
APP_URL=http://localhost:3000

# --- Supabase (new project: Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (test mode) ---
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen` locally, or the webhook endpoint in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Integration tests only (local Supabase database; the tests refuse to run against anything else) ---
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
